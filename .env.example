# Copy this file to ".env" and fill in your real values.

# Apollo.io API key — get it from Apollo: Settings -> Integrations -> API
APOLLO_API_KEY=your_apollo_api_key_here

# Your real identity, used in the email footer for CAN-SPAM / GDPR compliance.
# Cold email legally requires a real name + postal address + a way to opt out.
SENDER_NAME=Your Full Name
SENDER_POSTAL_ADDRESS=123 Example St, London, UK
